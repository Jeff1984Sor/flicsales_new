# Copie para backend/.env e ajuste. Nunca versione o .env. Aqui só NOMES e exemplos.
AMBIENTE=dev                       # dev | hml | prod
DEBUG=false                        # true só em dev (habilita /api/docs); hml/prod exigem false
ALLOWED_HOSTS=["localhost","127.0.0.1"]   # hml/prod: o domínio real + "127.0.0.1" (o Next chama a API por ele)
DATABASE_URL=sqlite:///./data/flicsales.db
# DATABASE_URL=postgresql+psycopg://flicsales_hml:SENHA@127.0.0.1:5432/flicsales_hml
STORAGE_DIR=./storage
FRONTEND_URL=http://localhost:3000       # hml/prod: https://...
CORS_ORIGINS=["http://localhost:3000"]

# Um banco por organização: NÃO há chave para ligar. O modo liga sozinho quando existe o banco de controle
# BANCO_CONTROLE no mesmo servidor do DATABASE_URL (no SQLite, data/<BANCO_CONTROLE>.db). Para criar:
#   uv run python -m app.controle.cli ativar
# Cada organização nova ganha <slug>.<DOMINIO_BASE>. Vazio = só domínios cadastrados à mão.
DOMINIO_BASE=
# Nomes dos bancos (o prefixo evita colisão com o flicsales antigo e deixa hml e prod no mesmo PostgreSQL).
# Organização <slug> → <BANCO_PREFIXO><slug>. Ex. hml: flicsalesos_controle_hml / flicsalesos_hml_
BANCO_CONTROLE=flicsalesos_controle
BANCO_PREFIXO=flicsalesos_
# Dados de demonstração numa organização (fora do dev; em prod só com --forcar):
#   uv run python -m app.seed --organizacao <slug>

# Obrigatórios e DIFERENTES do dev em hml/prod (a API não sobe com o valor de dev).
# JWT_SECRET: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# MASTER_KEY (Fernet; cifra senha SMTP, chave de IA e segredos de integrações):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MASTER_KEY=
MASTER_KEY_ANTERIOR=

# Produção: WORKER_EMBUTIDO=false (o serviço app.worker faz as tarefas) e MIGRAR_NA_SUBIDA=false (migrations no deploy)
WORKER_EMBUTIDO=true
MIGRAR_NA_SUBIDA=true

# Só para o seed de demonstração (dev). Sem ela, vale a senha de demonstração documentada no CLAUDE.md.
SEED_SENHA=
